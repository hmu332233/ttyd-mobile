{
  "name": "ttyd-mobile",
  "version": "0.2.0",
  "private": true,
  "description": "모바일 브라우저에서 원격 터미널을 사용하기 위한 ttyd 클라이언트와 PWA 런처",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:terminal": "npm run build -w @ttyd-mobile/terminal",
    "serve:terminal": "npm run serve -w @ttyd-mobile/terminal",
    "dev:launcher": "npm run dev -w @ttyd-mobile/launcher",
    "deploy:launcher": "npm run deploy -w @ttyd-mobile/launcher"
  },
  "license": "MIT"
}
